    <Content Include="..\..\..\..\Downloads\HarryParteIntegrador\HarryParteIntegrador\HarryParteIntegrador\Resources\IconEditar.png" Link="Recursos\Iconografia\IconEditar.png" />
    <Content Include="..\..\..\..\Downloads\HarryParteIntegrador\HarryParteIntegrador\HarryParteIntegrador\Resources\IconEntrega.png" Link="Recursos\Iconografia\IconEntrega.png" />
    <Content Include="..\..\..\..\Downloads\HarryParteIntegrador\HarryParteIntegrador\HarryParteIntegrador\Resources\MateriaBasededatos.png" Link="Recursos\IconosMateria\MateriaBasededatos.png" />
    <Content Include="..\..\..\..\Downloads\HarryParteIntegrador\HarryParteIntegrador\HarryParteIntegrador\Resources\MateriaDiseñoGFC.jpg" Link="Recursos\IconosMateria\MateriaDiseñoGFC.jpg" />
