  <ItemGroup>
    <Folder Include="Configuracion\" />
    <Folder Include="Recursos\Iconografia\" />
    <Folder Include="Recursos\IconosMateria\" />
    <Folder Include="Servicios\Autenticacion\" />
    <Folder Include="Servicios\Integraciones\" />
    <Folder Include="Servicios\Utilidades\" />
